# ===== mc-server-api 服务端（PHP）运行时产物 =====
# 进程内指标写盘（Windows php -S 跨请求持久化）
data/metrics.json
# 缓存持久化
data/cache.json
# 限流桶持久化
data/rate_limit*.json
data/ratelimit.json
data/webhook_state.json
# 动态 API Key（敏感！别进仓库）
data/api_keys.json
# SQLite 监控库（自动创建）
data/monitor.db
data/monitor.db-journal

# 解码后的资源缓存（自动创建，体积大）
favicons/
avatars/

# ===== mcmonitor 客户端（Go）构建 + 运行时 =====
# Windows 构建产物
client/mcmonitor.exe
# Unix 构建产物
client/mcmonitor
client/mcmonitor_dbg.exe
client/mcmon.exe
client/mcmon
# GUI 运行时采样落盘（快照 + history + events + log）
client/snapshots/
# 用户本地配置（config.example.json 是模板）
client/config.json
client/subscriptions.json

# ===== 构建产物 =====
release/

